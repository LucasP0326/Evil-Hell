    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "MainLight",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "#if defined(UNIVERSAL_LIGHTING_INCLUDED)\n    \nLight light = GetMainLight(ShadowSamplingData);\n    Direction = light.direction;\n    Color = light.color;\n    ShadowAtten = light.shadowAttenuation;\n\n#else\n    Direction = half3(0.5, 0.5, 0),\n    Color = half3(1, 1, 1);\n    ShadowAtten = 1.0;\n\n#endif"
}

